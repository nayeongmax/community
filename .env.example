# ── 배포에 필요한 값 ──────────────────────────────────────────
# Supabase (없으면 로컬 파일에 저장합니다 — 서버리스 배포에서는 동작하지 않습니다)
# 대시보드 Settings → API Keys 에서 가져옵니다.
SUPABASE_URL=https://xxxx.supabase.co

# 서버 전용 비밀 키. 브라우저로 절대 나가면 안 되므로 NEXT_PUBLIC_ 을 붙이지 않습니다.
# 새 형식(sb_secret_...) 을 권장하고, 예전 service_role 키도 그대로 동작합니다.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   ← 예전 이름. 위 값이 없을 때만 씁니다.

# 사이트 운영자 — 광고 배너를 다룰 수 있는 로그인 아이디 (쉼표로 여러 명)
# 비워 두면 아이디 'admin' 이 운영자입니다.
SITE_ADMIN_ID=admin

# 운영자 계정을 만들 때만 쓰는 값입니다 (npm run admin).
# 배포 환경에는 넣지 마세요 — 계정이 만들어지고 나면 필요 없습니다.
# ADMIN_ID=admin
# ADMIN_PASSWORD=

# 배포 도메인 — canonical 주소·사이트맵·RSS 에 쓰입니다
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=커뮤니티

# 네이버 서치어드바이저 소유확인 코드 (사이트 등록 후 받습니다)
NEXT_PUBLIC_NAVER_VERIFY=
